---
import '@fontsource-variable/inter';
const SITE_URL = 'https://projectone.me';

const canonical = Astro.url.origin + Astro.url.pathname;

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${SITE_URL}/#organization`,
      "name": "Project One",
      "url": SITE_URL,
      "logo": {
        "@type": "ImageObject",
        "url": `${SITE_URL}/favicon.svg`
      },
      "description": "AI visibility monitoring for UK sports and health brands. Project One tracks whether ChatGPT, Google AI Overviews, Gemini, Perplexity and Claude recommend your brand when people ask what to buy.",
      "email": "hello@projectone.me",
      "areaServed": {
        "@type": "Country",
        "name": "United Kingdom"
      },
      "knowsAbout": [
        "AI visibility",
        "AI visibility monitoring",
        "Generative Engine Optimisation",
        "Large language model search",
        "Sports nutrition ecommerce",
        "DTC health and wellness brands"
      ],
      "makesOffer": [
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Visibility Gap Report",
            "description": "A one-off audit of how a brand appears when people ask AI assistants what to buy, across ChatGPT, Google AI Overviews, Gemini, Perplexity and Claude, delivered as a written report with a prioritised action plan."
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "AI Visibility Monitoring",
            "description": "Monthly monitoring of a brand's visibility across ChatGPT, Google AI Overviews, Gemini, Perplexity and Claude, tracking how mentions and competitor recommendations change over time."
          }
        }
      ]
    },
    {
      "@type": "WebSite",
      "@id": `${SITE_URL}/#website`,
      "url": SITE_URL,
      "name": "Project One",
      "publisher": { "@id": `${SITE_URL}/#organization` }
    }
  ]
};
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="See whether ChatGPT, Google AI Overviews, Gemini, Perplexity and Claude recommend your brand — and who they suggest instead. Monthly AI visibility monitoring for UK sports and health ecommerce brands." />
		<title>Project One | AI Visibility Monitoring for UK Sports & Health Brands</title>
		<link rel="canonical" href={canonical} />
		<script type="application/ld+json" set:html={JSON.stringify(schema)} />
		<slot name="head" />
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	*, *::before, *::after {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	html {
		scroll-behavior: smooth;
	}

	body {
		font-family: 'Inter Variable', 'Inter', sans-serif;
		color: #fff;
		background: #000;
		line-height: 1.6;
	}
</style>
