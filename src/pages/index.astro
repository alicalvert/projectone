---
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is Generative Engine Optimisation (GEO)?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "GEO is the practice of optimising your content so it gets cited, referenced, and surfaced by AI-powered search engines — think Google AI Overviews, Perplexity, and ChatGPT. Where traditional SEO gets you onto a results page, GEO gets you into the answer itself."
      }
    },
    {
      "@type": "Question",
      "name": "How is GEO different from SEO?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "SEO is about ranking in Google's traditional blue-link results. GEO is about being the source that AI systems draw from when generating answers. The two complement each other — strong SEO foundations make GEO significantly more effective — but GEO requires its own distinct strategy around content structure, authority signals, and entity clarity."
      }
    },
    {
      "@type": "Question",
      "name": "What is AI visibility and why does it matter?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "AI visibility refers to how prominently your brand, products, or services appear when large language models like ChatGPT or Claude respond to relevant queries. As more people turn to AI assistants instead of search engines, being absent from those responses means missing a growing share of your potential audience — even if your Google rankings are strong."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need GEO if my SEO is already performing well?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Good SEO performance doesn't automatically translate into AI visibility. AI systems draw from a wide range of signals — structured data, brand mentions, content clarity, and third-party citations — that require separate attention. Businesses with strong SEO have a head start, but GEO is a distinct discipline that needs its own strategy."
      }
    },
    {
      "@type": "Question",
      "name": "How long does it take to see results?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "SEO results typically begin showing within 3–6 months, with significant growth compounding over time. GEO and AI visibility can move faster in some areas — particularly Google AI Overviews — though the landscape is evolving quickly. We set realistic timelines based on your current position and provide monthly reporting so you always know where things stand."
      }
    },
    {
      "@type": "Question",
      "name": "How do you measure AI visibility?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Every month I run a set of buyer-voiced questions — the natural-language prompts real shoppers actually type, like \"best electrolyte powder for runners\" or \"which recovery protein is worth it\" — across the five AI assistants that matter: ChatGPT, Google AI Overviews, Gemini, Perplexity and Claude. I record whether your brand is mentioned, where, and which competitors come up instead, using the DataForSEO AI Optimization API. Because it's tracked monthly, you see the trend rather than a one-off snapshot."
      }
    },
    {
      "@type": "Question",
      "name": "What does a visibility audit cover?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Our visibility audit assesses your current performance across traditional search, AI Overviews, and LLM platforms. We examine technical SEO health, content quality and structure, entity clarity, backlink profile, and AI citation signals. You receive a prioritised action plan that identifies exactly where the biggest gains are and in what order to pursue them."
      }
    },
    {
      "@type": "Question",
      "name": "How does pricing work?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Two options. The Visibility Gap Report is a one-off fixed fee. Monthly Monitoring is a monthly retainer with no long-term lock-in — you can stop whenever it stops being useful. I'll give you a quote after a short call, once I understand your categories and competitors."
      }
    },
    {
      "@type": "Question",
      "name": "Do you do the fixes as well?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. I diagnose where your brand is invisible and monitor how that changes — I don't implement the changes myself. No technical work, no content writing, no link building. The action plan is written so you can hand it straight to your developer or agency."
      }
    },
    {
      "@type": "Question",
      "name": "Do you work with Shopify brands?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Most of the sports and health brands I work with are DTC ecommerce running on Shopify. The monitoring looks at how AI assistants talk about your brand and products, so it works the same whatever platform your store is built on."
      }
    },
    {
      "@type": "Question",
      "name": "What's in the monthly report?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Which buyer questions surfaced your brand and which didn't, how that's moved since last month, which competitors are being recommended in your categories, and where the biggest new gaps are — with a short, prioritised list of what to tackle next."
      }
    }
  ]
};
---

<Layout>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />

	<!-- Nav -->
	<nav id="nav" data-theme="dark">
		<div class="container nav-inner">
			<a href="/" class="logo"><Logo /></a>
			<a href="#contact" class="btn-nav">Request an Audit</a>
		</div>
	</nav>

	<!-- Hero — DARK -->
	<section class="hero" id="hero" data-nav-theme="dark">
<div class="container">
			<p class="eyebrow reveal">AI Visibility Monitoring · UK Sports &amp; Health Brands</p>
			<h1 class="reveal reveal-delay-1">When someone asks ChatGPT for the best UK electrolyte powder, does your brand come up<span style="color:#FF2D78">?</span></h1>
			<p class="hero-sub reveal reveal-delay-2">Project One gives UK sports and health brands a monthly picture of where they appear across the big AI assistants — and which competitors get recommended instead.</p>
			<div class="hero-cta reveal reveal-delay-3">
				<a href="#contact" class="btn">See where you stand</a>
				<a href="#services" class="btn btn-ghost">See what's tracked</a>
			</div>
		</div>
	</section>

	<!-- Services — LIGHT -->
	<section class="section light" id="services" data-nav-theme="light">
		<div class="container">
			<div class="section-header reveal">
				<h2>What I do</h2>
				<p class="section-sub">Two products. One question: are the AI assistants recommending your brand, or someone else's?</p>
			</div>
			<div class="services-grid">
				<div class="service-box reveal">
					<span class="service-num">01 · One-off</span>
					<h3>Visibility Gap Report</h3>
					<p>A one-off audit of how your brand shows up when people ask AI assistants what to buy. I run buyer-voiced questions across ChatGPT, Google AI Overviews, Gemini, Perplexity and Claude for your categories — electrolyte powders, protein, recovery supplements, running kit — and record where you appear and who gets recommended instead. You get a written report with a prioritised action plan, usually within about a week.</p>
				</div>
				<div class="service-box reveal service-box--highlight">
					<span class="service-num">02 · Monthly</span>
					<h3>Monthly Monitoring</h3>
					<p>Ongoing tracking across the same five assistants. Each month you get a report showing which questions surface your brand, how that's moved since last month, which competitors are gaining ground in your categories, and where the new gaps are. It turns a one-off snapshot into a trend you can act on.</p>
				</div>
			</div>
			<p class="services-pricing reveal">Fixed-price audit, monthly retainer for monitoring, no long-term contract — <a href="#contact">get in touch for a quote</a>.</p>
			<div class="dont-do reveal">
				<h3>What I don't do</h3>
				<p>I don't implement the fixes. No technical changes, no content writing, no link building. I diagnose where your brand is invisible and monitor how it changes over time — the action plan is written in plain English so you can hand it straight to your own developer or agency to execute.</p>
			</div>
		</div>
	</section>

	<!-- Report preview — DARK -->
	<section class="section dark" id="report" data-nav-theme="dark">
		<div class="container">
			<div class="section-header reveal">
				<h2>What you actually get</h2>
				<p class="section-sub">Every report is a plain-English document you can read in ten minutes and hand straight to whoever makes the changes.</p>
			</div>
			<figure class="report-preview reveal">
				<!-- Replace this slot with <img src="/report-preview.png" ... /> once the screenshot is supplied -->
				<div class="report-preview__slot">
					<span>Report preview — screenshot to be added at <code>/report-preview.png</code></span>
				</div>
				<figcaption>A sample page from a monthly AI visibility report.</figcaption>
			</figure>
		</div>
	</section>

	<!-- FAQs — DARK -->
	<section class="section dark" id="faqs" data-nav-theme="dark">
		<div class="container">
			<div class="faq-layout">
				<div class="faq-header reveal">
					<h2>FAQs</h2>
					<p class="section-sub">Everything you need to know about AI visibility monitoring.</p>
				</div>
			<div class="faq-list reveal">

				<div class="faq-item">
					<button class="faq-question" aria-expanded="false">
						What is Generative Engine Optimisation (GEO)?
						<span class="faq-icon">+</span>
					</button>
					<div class="faq-answer">
						<p>GEO is the practice of optimising your content so it gets cited, referenced, and surfaced by AI-powered search engines — think Google AI Overviews, Perplexity, and ChatGPT. Where traditional SEO gets you onto a results page, GEO gets you into the answer itself.</p>
					</div>
				</div>

				<div class="faq-item">
					<button class="faq-question" aria-expanded="false">
						How is GEO different from SEO?
						<span class="faq-icon">+</span>
					</button>
					<div class="faq-answer">
						<p>SEO is about ranking in Google's traditional blue-link results. GEO is about being the source that AI systems draw from when generating answers. The two complement each other — strong SEO foundations make GEO significantly more effective — but GEO requires its own distinct strategy around content structure, authority signals, and entity clarity.</p>
					</div>
				</div>

				<div class="faq-item">
					<button class="faq-question" aria-expanded="false">
						What is AI visibility and why does it matter?
						<span class="faq-icon">+</span>
					</button>
					<div class="faq-answer">
						<p>AI visibility refers to how prominently your brand, products, or services appear when large language models like ChatGPT or Claude respond to relevant queries. As more people turn to AI assistants instead of search engines, being absent from those responses means missing a growing share of your potential audience — even if your Google rankings are strong.</p>
					</div>
				</div>

				<div class="faq-item">
					<button class="faq-question" aria-expanded="false">
						Do I need GEO if my SEO is already performing well?
						<span class="faq-icon">+</span>
					</button>
					<div class="faq-answer">
						<p>Yes. Good SEO performance doesn't automatically translate into AI visibility. AI systems draw from a wide range of signals — structured data, brand mentions, content clarity, and third-party citations — that require separate attention. Businesses with strong SEO have a head start, but GEO is a distinct discipline that needs its own strategy.</p>
					</div>
				</div>

				<div class="faq-item">
					<button class="faq-question" aria-expanded="false">
						How long does it take to see results?
						<span class="faq-icon">+</span>
					</button>
					<div class="faq-answer">
						<p>SEO results typically begin showing within 3–6 months, with significant growth compounding over time. GEO and AI visibility can move faster in some areas — particularly Google AI Overviews — though the landscape is evolving quickly. We set realistic timelines based on your current position and provide monthly reporting so you always know where things stand.</p>
					</div>
				</div>

				<div class="faq-item">
					<button class="faq-question" aria-expanded="false">
						How do you measure AI visibility?
						<span class="faq-icon">+</span>
					</button>
					<div class="faq-answer">
						<p>Every month I run a set of buyer-voiced questions — the natural-language prompts real shoppers actually type, like "best electrolyte powder for runners" or "which recovery protein is worth it" — across the five AI assistants that matter: ChatGPT, Google AI Overviews, Gemini, Perplexity and Claude. I record whether your brand is mentioned, where, and which competitors come up instead, using the DataForSEO AI Optimization API. Because it's tracked monthly, you see the trend rather than a one-off snapshot.</p>
					</div>
				</div>

				<div class="faq-item">
					<button class="faq-question" aria-expanded="false">
						What does a visibility audit cover?
						<span class="faq-icon">+</span>
					</button>
					<div class="faq-answer">
						<p>Our visibility audit assesses your current performance across traditional search, AI Overviews, and LLM platforms. We examine technical SEO health, content quality and structure, entity clarity, backlink profile, and AI citation signals. You receive a prioritised action plan that identifies exactly where the biggest gains are and in what order to pursue them.</p>
					</div>
				</div>

				<div class="faq-item">
					<button class="faq-question" aria-expanded="false">
						How does pricing work?
						<span class="faq-icon">+</span>
					</button>
					<div class="faq-answer">
						<p>Two options. The Visibility Gap Report is a one-off fixed fee. Monthly Monitoring is a monthly retainer with no long-term lock-in — you can stop whenever it stops being useful. I'll give you a quote after a short call, once I understand your categories and competitors.</p>
					</div>
				</div>

				<div class="faq-item">
					<button class="faq-question" aria-expanded="false">
						Do you do the fixes as well?
						<span class="faq-icon">+</span>
					</button>
					<div class="faq-answer">
						<p>No. I diagnose where your brand is invisible and monitor how that changes — I don't implement the changes myself. No technical work, no content writing, no link building. The action plan is written so you can hand it straight to your developer or agency.</p>
					</div>
				</div>

				<div class="faq-item">
					<button class="faq-question" aria-expanded="false">
						Do you work with Shopify brands?
						<span class="faq-icon">+</span>
					</button>
					<div class="faq-answer">
						<p>Yes. Most of the sports and health brands I work with are DTC ecommerce running on Shopify. The monitoring looks at how AI assistants talk about your brand and products, so it works the same whatever platform your store is built on.</p>
					</div>
				</div>

				<div class="faq-item">
					<button class="faq-question" aria-expanded="false">
						What's in the monthly report?
						<span class="faq-icon">+</span>
					</button>
					<div class="faq-answer">
						<p>Which buyer questions surfaced your brand and which didn't, how that's moved since last month, which competitors are being recommended in your categories, and where the biggest new gaps are — with a short, prioritised list of what to tackle next.</p>
					</div>
				</div>

			</div>
			</div>
		</div>
	</section>

	<!-- Contact — LIGHT -->
	<section class="section light" id="contact" data-nav-theme="light">
		<div class="container container-narrow">
			<div class="section-header reveal">
				<h2>See where you stand</h2>
				<p class="section-sub">Tell me about your brand and I'll show you where you're showing up — and where you're missing out — across ChatGPT, Google AI Overviews, Gemini, Perplexity and Claude, and who's being recommended instead.</p>
			</div>
			<form class="form reveal" id="contact-form">
				<div class="form-row">
					<input type="text" name="name" placeholder="Your name" required />
					<input type="email" name="email" placeholder="Your email" required />
				</div>
				<input type="text" name="website" placeholder="Your website URL (e.g. www.example.com)" required />
				<textarea name="message" placeholder="Tell me about your brand, your categories and your main competitors" rows="4"></textarea>
				<button type="submit" class="btn btn-full" id="contact-submit">See where I stand</button>
				<p id="contact-status" style="display:none;margin-top:1rem;text-align:center;font-size:0.9rem;"></p>
			</form>

			<script>
				const form = document.getElementById('contact-form') as HTMLFormElement;
				const btn = document.getElementById('contact-submit') as HTMLButtonElement;
				const status = document.getElementById('contact-status') as HTMLParagraphElement;

				form.addEventListener('submit', async (e) => {
					e.preventDefault();
					btn.disabled = true;
					btn.textContent = 'Sending…';
					status.style.display = 'none';

					let website = (form.elements.namedItem('website') as HTMLInputElement).value.trim();
					if (website && !/^https?:\/\//i.test(website)) {
						website = 'https://' + website;
					}

					const data = {
						name: (form.elements.namedItem('name') as HTMLInputElement).value,
						email: (form.elements.namedItem('email') as HTMLInputElement).value,
						website,
						message: (form.elements.namedItem('message') as HTMLTextAreaElement).value,
					};

					try {
						const res = await fetch('/api/contact', {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify(data),
						});

						if (res.ok) {
							form.reset();
							status.textContent = 'Thanks — I\'ll be in touch shortly.';
							status.style.color = '#00A878';
							btn.textContent = 'See where I stand';
							btn.disabled = false;
						} else {
							throw new Error();
						}
					} catch {
						status.textContent = 'Something went wrong. Please email me directly at hello@projectone.me';
						status.style.color = '#E63946';
						btn.textContent = 'Request Your Audit';
						btn.disabled = false;
					}

					status.style.display = 'block';
				});
			</script>
		</div>
	</section>

	<!-- Footer -->
	<footer data-nav-theme="dark">
		<div class="container">
			<div class="footer-top">
				<div class="footer-brand">
					<a href="/" class="logo"><Logo /></a>
					<p class="footer-tagline">AI VISIBILITY MONITORING · UK SPORTS &amp; HEALTH BRANDS</p>
				</div>
				<div class="footer-col">
					<h4>Contact</h4>
					<ul>
						<li><a href="mailto:hello@projectone.me">hello@projectone.me</a></li>
					</ul>
				</div>
				<div class="footer-col">
					<h4>Company</h4>
					<ul>
						<li>About</li>
						<li>Cookie Policy</li>
						<li>Privacy Policy</li>
					</ul>
				</div>
			</div>
			<div class="footer-bottom">
				<p>&copy; 2026 PROJECT ONE &middot; PROJECTONE.ME</p>
			</div>
		</div>
	</footer>

</Layout>

<style>
	/* ── Base ── */
	.container {
		max-width: 1100px;
		margin: 0 auto;
		padding: 0 2rem;
	}

	.container-narrow {
		max-width: 680px;
	}

	/* ── Scroll reveal ── */
	.reveal {
		opacity: 0;
		transform: translateY(28px);
		transition: opacity 0.75s ease, transform 0.75s ease;
	}

	.reveal.visible {
		opacity: 1;
		transform: translateY(0);
	}

	.reveal-delay-1 { transition-delay: 0.1s; }
	.reveal-delay-2 { transition-delay: 0.22s; }
	.reveal-delay-3 { transition-delay: 0.36s; }

	/* ── Nav ── */
	nav {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 100;
		padding: 1.25rem 0;
		transition: background 0.5s ease, border-color 0.5s ease;
		border-bottom: 1px solid transparent;
	}

	nav[data-theme="dark"] {
		background: rgba(0, 0, 0, 0.88);
		border-color: #222;
	}

	nav[data-theme="light"] {
		background: rgba(255, 255, 255, 0.9);
		border-color: #e5e7eb;
	}

	.nav-inner {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.logo {
		display: flex;
		align-items: center;
		text-decoration: none;
		transition: color 0.4s ease;
	}

	nav[data-theme="dark"] .logo { color: #fff; }
	nav[data-theme="light"] .logo { color: #000; }

	.btn-nav {
		font-size: 0.85rem;
		font-weight: 600;
		padding: 0.5rem 1.1rem;
		border-radius: 6px;
		text-decoration: none;
		transition: background 0.4s ease, color 0.4s ease, border-color 0.4s ease;
		border: 1px solid transparent;
	}

	nav[data-theme="dark"] .btn-nav {
		background: #fff;
		color: #000;
		border-color: #fff;
	}

	nav[data-theme="light"] .btn-nav {
		background: #000;
		color: #fff;
		border-color: #000;
	}

	/* ── Sections ── */
	.hero,
	.section.dark,
	footer {
		background: #000;
		color: #fff;
	}

	.section.light {
		background: #fff;
		color: #000;
	}

	/* ── Hero ── */
	.hero {
		min-height: 100svh;
		display: flex;
		align-items: center;
		padding: 8rem 0 6rem;
		transition: background 0.5s ease;
	}

	.hero.scrolled {
		background: #fff;
	}

	.hero.scrolled .eyebrow {
		color: #aaa;
	}

	.hero.scrolled h1 {
		color: #000;
	}

	.hero.scrolled .hero-sub {
		color: #666;
	}

	.hero.scrolled .btn {
		background: #000;
		color: #fff;
		border-color: #000;
	}

	.hero.scrolled .btn:hover {
		background: #222;
		border-color: #222;
	}

	.hero.scrolled .btn-ghost {
		background: transparent;
		color: #000;
		border-color: #aaa;
	}

	.hero.scrolled .btn-ghost:hover {
		background: #000;
		color: #fff;
		border-color: #000;
	}

	.eyebrow {
		font-size: 0.78rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.15em;
		color: #b0b0b0;
		margin-bottom: 1.5rem;
		transition: color 0.5s ease;
	}

	.hero h1 {
		font-size: clamp(2.1rem, 5vw, 3.6rem);
		font-weight: 800;
		line-height: 1.12;
		letter-spacing: -0.03em;
		margin-bottom: 1.5rem;
		max-width: 900px;
		color: #fff;
		transition: color 0.5s ease;
	}

	.hero-sub {
		font-size: 1.1rem;
		color: #c8c8c8;
		max-width: 480px;
		margin-bottom: 2.5rem;
		line-height: 1.7;
		transition: color 0.5s ease;
	}

	.hero-cta {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
	}

	/* ── Buttons ── */
	.btn {
		display: inline-block;
		background: #fff;
		color: #000;
		padding: 0.85rem 1.75rem;
		border-radius: 6px;
		font-weight: 700;
		font-size: 0.95rem;
		text-decoration: none;
		border: 1px solid #fff;
		cursor: pointer;
		transition: background 0.2s, color 0.2s;
	}

	.btn:hover { background: #e0e0e0; border-color: #e0e0e0; }

	.btn-ghost {
		background: transparent;
		color: #fff;
		border-color: #444;
	}

	.btn-ghost:hover {
		background: #fff;
		color: #000;
		border-color: #fff;
	}

	.btn-full {
		width: 100%;
		text-align: center;
		padding: 1rem;
		font-size: 1rem;
	}

	.section.light .btn-full {
		background: #000;
		color: #fff;
		border-color: #000;
	}

	.section.light .btn-full:hover {
		background: #222;
		border-color: #222;
	}

	/* ── Generic section spacing ── */
	.section {
		padding: 7rem 0;
	}

	.section-header {
		margin-bottom: 4rem;
	}

	.section-header h2 {
		font-size: clamp(2rem, 5vw, 3.5rem);
		font-weight: 800;
		letter-spacing: -0.03em;
		line-height: 1.1;
		margin-bottom: 0.75rem;
	}

	.section-sub {
		font-size: 1rem;
		color: #c8c8c8;
	}

	.section.light .section-sub { color: #666; }

	/* ── Services ── */
	.services-grid {
		display: grid;
