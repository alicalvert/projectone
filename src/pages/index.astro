---
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';

// Flip to true once /public/report-preview.png has been added.
const SHOW_REPORT_PREVIEW = true;

// Flip to true once the case study facts below are confirmed.
const SHOW_CASE_STUDIES = true;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What's in the monthly report?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Which buyer questions surfaced your brand and which didn't, how that's moved since last month, which competitors are being recommended in your categories, and where the biggest new gaps are, with a short, prioritised list of what to tackle next."
      }
    },
    {
      "@type": "Question",
      "name": "How does pricing work?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Two options. The Visibility Gap Report is a one-off fixed fee. Monthly Monitoring is a monthly retainer with no long-term lock-in. You can stop whenever it stops being useful. I'll give you a quote after a short call, once I understand your categories and competitors."
      }
    },
    {
      "@type": "Question",
      "name": "Do you do the fixes as well?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. I diagnose where your brand is invisible and monitor how that changes. I don't implement the changes myself. No technical work, no content writing, no link building. The action plan is written so you can hand it straight to your developer or agency."
      }
    },
    {
      "@type": "Question",
      "name": "How do you measure AI visibility?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Every month I run a set of buyer-voiced questions (the natural-language prompts real shoppers actually type, like \"best electrolyte powder for runners\" or \"which recovery protein is worth it\") across the five AI assistants that matter: ChatGPT, Google AI Overviews, Gemini, Perplexity and Claude. I record whether your brand is mentioned, where, and which competitors come up instead, using the DataForSEO AI Optimization API. Because it's tracked monthly, you see the trend rather than a one-off snapshot."
      }
    },
    {
      "@type": "Question",
      "name": "What does a visibility audit cover?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The Visibility Gap Report is a one-off snapshot of how your brand shows up when people ask AI assistants what to buy. I run buyer-voiced questions across ChatGPT, Google AI Overviews, Gemini, Perplexity and Claude for your categories, then record where you appear, which competitors get recommended instead, and the source domains those recommendations lean on. You get a prioritised action plan written to be handed straight to your developer, usually within about a week."
      }
    },
    {
      "@type": "Question",
      "name": "Do you work with Shopify brands?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Most of the sports and health brands I work with are DTC ecommerce running on Shopify. The monitoring looks at how AI assistants talk about your brand and products, so it works the same whatever platform your store is built on."
      }
    },
    {
      "@type": "Question",
      "name": "What is AI visibility and why does it matter?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "AI visibility refers to how prominently your brand, products, or services appear when large language models like ChatGPT or Claude respond to relevant queries. As more people turn to AI assistants instead of search engines, being absent from those responses means missing a growing share of your potential audience, even if your Google rankings are strong."
      }
    },
    {
      "@type": "Question",
      "name": "How long does it take to see results?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The first picture arrives with the Visibility Gap Report, usually within about a week. After that, how quickly things move depends on your team acting on the plan. I diagnose and monitor, but the changes themselves are made by your developer or agency. Monitoring is what shows whether they worked. Bear in mind that the AI assistants re-crawl and re-index on their own timelines, so even once a change is live it can take weeks to show up in their answers."
      }
    },
    {
      "@type": "Question",
      "name": "What is Generative Engine Optimisation (GEO)?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "GEO is the practice of optimising your content so it gets cited, referenced, and surfaced by AI-powered search engines like Google AI Overviews, Perplexity, and ChatGPT. Where traditional SEO gets you onto a results page, GEO gets you into the answer itself."
      }
    },
    {
      "@type": "Question",
      "name": "How is GEO different from SEO?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "SEO is about ranking in Google's traditional blue-link results. GEO is about being the source that AI systems draw from when generating answers. The two complement each other (strong SEO foundations make GEO significantly more effective), but GEO requires its own distinct strategy around content structure, authority signals, and entity clarity."
      }
    },
    {
      "@type": "Question",
      "name": "Do I need GEO if my SEO is already performing well?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Good SEO performance doesn't automatically translate into AI visibility. AI systems draw from a wide range of signals (structured data, brand mentions, content clarity, and third-party citations) that require separate attention. Businesses with strong SEO have a head start, but GEO is a distinct discipline that needs its own strategy."
      }
    }
  ]
};
---

<Layout>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />

	<!-- Nav -->
	<nav id="nav" data-theme="dark">
		<div class="container nav-inner">
			<a href="/" class="logo"><Logo /></a>
			<a href="#contact" class="btn-nav">See where you stand</a>
		</div>
	</nav>

	<!-- Hero - DARK -->
	<section class="hero" id="hero" data-nav-theme="dark">
<div class="container">
			<p class="eyebrow reveal">AI Visibility Monitoring · UK Sports &amp; Health Brands</p>
			<h1 class="reveal reveal-delay-1">When someone asks ChatGPT for the best UK electrolyte powder, does your brand come up<span style="color:#FF2D78;margin-left:-0.06em">?</span></h1>
			<p class="hero-sub reveal reveal-delay-2">Project One gives UK sports and health brands a monthly picture of where they appear across the big AI assistants, and which competitors get recommended instead.</p>
			<div class="hero-cta reveal reveal-delay-3">
				<a href="#contact" class="btn">See where you stand</a>
				<a href="#services" class="btn btn-ghost">See what's tracked</a>
			</div>
		</div>
	</section>

	<!-- Services - LIGHT -->
	<section class="section light" id="services" data-nav-theme="light">
		<div class="container">
			<div class="section-header reveal">
				<h2>What I do</h2>
				<p class="section-sub">Two products. One question: are the AI assistants recommending your brand, or someone else's?</p>
			</div>
			<div class="services-grid">
				<article class="service-box reveal">
					<div class="service-top">
						<span class="service-tag">One-off</span>
						<span class="service-meta">~1 week</span>
					</div>
					<h3>Visibility Gap Report</h3>
					<p class="service-lead">A clear snapshot of exactly how your brand shows up when shoppers ask AI what to buy.</p>
					<ul class="service-points">
						<li>Buyer-voiced questions run across all five assistants</li>
						<li>Where you appear, and who's recommended instead</li>
						<li>The source domains shaping those answers</li>
						<li>Whether the AI crawlers can actually read and cite your site</li>
						<li>How clear your structured data and brand entity are to AI</li>
						<li>A prioritised action plan for your developer</li>
					</ul>
				</article>
				<article class="service-box reveal service-box--highlight">
					<div class="service-top">
						<span class="service-tag">Monthly</span>
						<span class="service-meta">Every month</span>
					</div>
					<h3>Monthly Monitoring</h3>
					<p class="service-lead">Turn that snapshot into a trend you can actually act on.</p>
					<ul class="service-points">
						<li>Tracked across ChatGPT, AI Overviews, Gemini, Perplexity &amp; Claude</li>
						<li>What's moved since last month</li>
						<li>Which competitors are gaining ground</li>
						<li>Where the new gaps are opening up</li>
						<li>A monthly check that the AI crawlers still have access</li>
					</ul>
				</article>
			</div>

			<div class="services-note reveal">
				<span class="pill">Fixed-price audit</span>
				<span class="pill">Monthly retainer</span>
				<span class="pill">No long-term contract</span>
				<a href="#contact" class="services-quote">Get a quote &rarr;</a>
			</div>

			<div class="dont-do reveal">
				<h3>What I don't do</h3>
				<p>I diagnose and monitor. I don't implement. The plan is written in plain English to hand straight to your own developer or agency.</p>
				<div class="dont-list">
					<span class="dont-item">Technical changes</span>
					<span class="dont-item">Content writing</span>
					<span class="dont-item">Link building</span>
				</div>
			</div>
		</div>
	</section>

	<!-- Clients - DARK (hidden until logos confirmed; flip SHOW_CASE_STUDIES in the frontmatter) -->
	{SHOW_CASE_STUDIES && (
	<section class="section dark" id="cases" data-nav-theme="dark">
		<div class="container">
			<div class="section-header reveal">
				<h2>In good company</h2>
				<p class="section-sub">Every day, shoppers ask AI assistants what to buy. I track those answers for health and fitness brands like these.</p>
			</div>

			<div class="ai-search reveal">
				<p class="ai-search-eyebrow">Someone asks an AI assistant…</p>
				<div class="ai-search-bar">
					<svg class="ai-search-spark" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0l2.6 9.4L24 12l-9.4 2.6L12 24l-2.6-9.4L0 12l9.4-2.6z"/></svg>
					<span class="ai-search-text"><span id="ai-typed">best UK electrolyte drinks for endurance athletes</span><span class="ai-caret" aria-hidden="true"></span></span>
				</div>
				<div class="ai-engines" id="ai-engines" aria-label="Assistants monitored">
					<span>ChatGPT</span>
					<span>AI Overviews</span>
					<span>Gemini</span>
					<span>Perplexity</span>
					<span>Claude</span>
				</div>
			</div>

			<p class="clients-label reveal">Trusted by</p>
			<div class="clients-row reveal">
				<img class="client-logo client-logo--tgc" src="/logos/general-classification.png" alt="The General Classification" loading="lazy" />
				<span class="client-wordmark">Fluid Fitness</span>
				<img class="client-logo" src="/logos/postea.png" alt="PosTea" loading="lazy" />
				<img class="client-logo" src="/logos/drops.svg" alt="Drops" loading="lazy" />
				<span class="client-more">&amp; more</span>
			</div>
		</div>
	</section>
	)}

	<!-- Report preview - LIGHT (flip SHOW_REPORT_PREVIEW in the frontmatter to hide) -->
	{SHOW_REPORT_PREVIEW && (
	<section class="section light" id="report" data-nav-theme="light">
		<div class="container">
			<div class="section-header reveal">
				<h2>What you actually get</h2>
				<p class="section-sub">Every report is a plain-English document you can read in ten minutes and hand straight to whoever makes the changes.</p>
			</div>
			<figure class="report-preview reveal">
				<div class="report-stage">
				<div class="report-mock" data-report>
					<div class="report-mock__head">
						<div>
							<p class="report-mock__eyebrow">Monthly AI Visibility Report</p>
							<p class="report-mock__title">Where your brand shows up</p>
						</div>
						<span class="report-mock__badge">Overview</span>
					</div>
					<div class="report-mock__bars">
						<div class="report-bar" style="--val:72%"><span class="report-bar__name">ChatGPT</span><span class="report-bar__track"><span class="report-bar__fill"></span></span><span class="report-bar__num" data-count="72">0%</span></div>
						<div class="report-bar" style="--val:61%"><span class="report-bar__name">Perplexity</span><span class="report-bar__track"><span class="report-bar__fill"></span></span><span class="report-bar__num" data-count="61">0%</span></div>
						<div class="report-bar" style="--val:54%"><span class="report-bar__name">AI Overviews</span><span class="report-bar__track"><span class="report-bar__fill"></span></span><span class="report-bar__num" data-count="54">0%</span></div>
						<div class="report-bar" style="--val:45%"><span class="report-bar__name">Claude</span><span class="report-bar__track"><span class="report-bar__fill"></span></span><span class="report-bar__num" data-count="45">0%</span></div>
						<div class="report-bar" style="--val:38%"><span class="report-bar__name">Gemini</span><span class="report-bar__track"><span class="report-bar__fill"></span></span><span class="report-bar__num" data-count="38">0%</span></div>
					</div>
					<div class="report-mock__foot">
						<span class="report-chip report-chip--up">&#9650; 3 new mentions</span>
						<span class="report-chip">vs 4 competitors</span>
						<span class="report-chip report-chip--flag">2 gaps flagged</span>
					</div>
				</div>

				<div class="report-widget report-widget--sov" aria-hidden="true">
					<div class="sov-ring"><span>34%</span></div>
					<div class="sov-meta"><strong>Share of voice</strong><span>vs your category</span></div>
				</div>

				<div class="report-widget report-widget--sources" aria-hidden="true">
					<p class="widget-label">Top cited sources</p>
					<ul class="widget-sources">
						<li><span class="src-dot"></span>reddit.com</li>
						<li><span class="src-dot"></span>myprotein.com</li>
						<li><span class="src-dot"></span>runnersworld.com</li>
					</ul>
				</div>

				<div class="report-widget report-widget--mention" aria-hidden="true">
					<p class="widget-label">Sample mention</p>
					<p class="mention-quote">"For endurance athletes, <mark>your brand</mark> is a solid pick..."</p>
					<span class="mention-src">ChatGPT</span>
				</div>

				<div class="report-widget report-widget--crawler" aria-hidden="true">
					<span class="crawler-check">&#10003;</span>
					<div><strong>AI crawlers</strong><span>GPTBot &middot; ClaudeBot allowed</span></div>
				</div>

				<div class="report-widget report-widget--trend" aria-hidden="true">
					<p class="widget-label">Mentions trend</p>
					<svg class="spark" viewBox="0 0 100 32" preserveAspectRatio="none" aria-hidden="true"><polyline points="0,27 20,23 40,25 60,15 80,11 100,4" fill="none" stroke="#FF2D78" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
					<span class="trend-stat">&#9650; +3 this month</span>
				</div>

				<div class="report-widget report-widget--rank" aria-hidden="true">
					<p class="widget-label">Category leaderboard</p>
					<ol class="rank-list">
						<li><span class="rank-pos">1</span><span>Competitor A</span><span class="rank-val">41%</span></li>
						<li class="rank-you"><span class="rank-pos">2</span><span>Your brand</span><span class="rank-val">34%</span></li>
						<li><span class="rank-pos">3</span><span>Competitor B</span><span class="rank-val">18%</span></li>
					</ol>
				</div>

				<div class="report-widget report-widget--sentiment" aria-hidden="true">
					<p class="widget-label">How you're described</p>
					<div class="sentiment-bar">
						<span class="seg seg-pos" style="width:78%"></span>
						<span class="seg seg-neu" style="width:16%"></span>
						<span class="seg seg-neg" style="width:6%"></span>
					</div>
					<div class="sentiment-key">
						<span><i class="dot-pos"></i>78% positive</span>
						<span><i class="dot-neg"></i>6% negative</span>
					</div>
				</div>

				</div>
				<figcaption>A sample of what your monthly report looks like. Illustrative figures, not a real brand.</figcaption>
			</figure>
		</div>
	</section>
	)}

	<!-- FAQs - DARK -->
	<section class="section dark" id="faqs" data-nav-theme="dark">
		<div class="container">
			<div class="faq-layout">
				<div class="faq-header reveal">
					<h2>FAQs</h2>
					<p class="section-sub">Everything you need to know about AI visibility monitoring.</p>
				</div>
			<div class="faq-list reveal">

					<div class="faq-item">
						<button class="faq-question" aria-expanded="false">
							What's in the monthly report?
							<span class="faq-icon">+</span>
						</button>
						<div class="faq-answer">
							<p>Which buyer questions surfaced your brand and which didn't, how that's moved since last month, which competitors are being recommended in your categories, and where the biggest new gaps are, with a short, prioritised list of what to tackle next.</p>
						</div>
					</div>

					<div class="faq-item">
						<button class="faq-question" aria-expanded="false">
							How does pricing work?
							<span class="faq-icon">+</span>
						</button>
						<div class="faq-answer">
							<p>Two options. The Visibility Gap Report is a one-off fixed fee. Monthly Monitoring is a monthly retainer with no long-term lock-in. You can stop whenever it stops being useful. I'll give you a quote after a short call, once I understand your categories and competitors.</p>
						</div>
					</div>

					<div class="faq-item">
						<button class="faq-question" aria-expanded="false">
							Do you do the fixes as well?
							<span class="faq-icon">+</span>
						</button>
						<div class="faq-answer">
							<p>No. I diagnose where your brand is invisible and monitor how that changes. I don't implement the changes myself. No technical work, no content writing, no link building. The action plan is written so you can hand it straight to your developer or agency.</p>
						</div>
					</div>

					<div class="faq-item">
						<button class="faq-question" aria-expanded="false">
							How do you measure AI visibility?
							<span class="faq-icon">+</span>
						</button>
						<div class="faq-answer">
							<p>Every month I run a set of buyer-voiced questions (the natural-language prompts real shoppers actually type, like "best electrolyte powder for runners" or "which recovery protein is worth it") across the five AI assistants that matter: ChatGPT, Google AI Overviews, Gemini, Perplexity and Claude. I record whether your brand is mentioned, where, and which competitors come up instead, using the DataForSEO AI Optimization API. Because it's tracked monthly, you see the trend rather than a one-off snapshot.</p>
						</div>
					</div>

					<div class="faq-item">
						<button class="faq-question" aria-expanded="false">
							What does a visibility audit cover?
							<span class="faq-icon">+</span>
						</button>
						<div class="faq-answer">
							<p>The Visibility Gap Report is a one-off snapshot of how your brand shows up when people ask AI assistants what to buy. I run buyer-voiced questions across ChatGPT, Google AI Overviews, Gemini, Perplexity and Claude for your categories, then record where you appear, which competitors get recommended instead, and the source domains those recommendations lean on. You get a prioritised action plan written to be handed straight to your developer, usually within about a week.</p>
						</div>
					</div>

					<div class="faq-item">
						<button class="faq-question" aria-expanded="false">
							Do you work with Shopify brands?
							<span class="faq-icon">+</span>
						</button>
						<div class="faq-answer">
							<p>Yes. Most of the sports and health brands I work with are DTC ecommerce running on Shopify. The monitoring looks at how AI assistants talk about your brand and products, so it works the same whatever platform your store is built on.</p>
						</div>
					</div>

					<div class="faq-item">
						<button class="faq-question" aria-expanded="false">
							What is AI visibility and why does it matter?
							<span class="faq-icon">+</span>
						</button>
						<div class="faq-answer">
							<p>AI visibility refers to how prominently your brand, products, or services appear when large language models like ChatGPT or Claude respond to relevant queries. As more people turn to AI assistants instead of search engines, being absent from those responses means missing a growing share of your potential audience, even if your Google rankings are strong.</p>
						</div>
					</div>

					<div class="faq-item">
						<button class="faq-question" aria-expanded="false">
							How long does it take to see results?
							<span class="faq-icon">+</span>
						</button>
						<div class="faq-answer">
							<p>The first picture arrives with the Visibility Gap Report, usually within about a week. After that, how quickly things move depends on your team acting on the plan. I diagnose and monitor, but the changes themselves are made by your developer or agency. Monitoring is what shows whether they worked. Bear in mind that the AI assistants re-crawl and re-index on their own timelines, so even once a change is live it can take weeks to show up in their answers.</p>
						</div>
					</div>

					<div class="faq-item">
						<button class="faq-question" aria-expanded="false">
							What is Generative Engine Optimisation (GEO)?
							<span class="faq-icon">+</span>
						</button>
						<div class="faq-answer">
							<p>GEO is the practice of optimising your content so it gets cited, referenced, and surfaced by AI-powered search engines like Google AI Overviews, Perplexity, and ChatGPT. Where traditional SEO gets you onto a results page, GEO gets you into the answer itself.</p>
						</div>
					</div>

					<div class="faq-item">
						<button class="faq-question" aria-expanded="false">
							How is GEO different from SEO?
							<span class="faq-icon">+</span>
						</button>
						<div class="faq-answer">
							<p>SEO is about ranking in Google's traditional blue-link results. GEO is about being the source that AI systems draw from when generating answers. The two complement each other (strong SEO foundations make GEO significantly more effective), but GEO requires its own distinct strategy around content structure, authority signals, and entity clarity.</p>
						</div>
					</div>

					<div class="faq-item">
						<button class="faq-question" aria-expanded="false">
							Do I need GEO if my SEO is already performing well?
							<span class="faq-icon">+</span>
						</button>
						<div class="faq-answer">
							<p>Yes. Good SEO performance doesn't automatically translate into AI visibility. AI systems draw from a wide range of signals (structured data, brand mentions, content clarity, and third-party citations) that require separate attention. Businesses with strong SEO have a head start, but GEO is a distinct discipline that needs its own strategy.</p>
						</div>
					</div>

			</div>
			</div>
		</div>
	</section>

	<!-- Contact - LIGHT -->
	<section class="section light" id="contact" data-nav-theme="light">
		<div class="container container-narrow">
			<div class="section-header reveal">
				<h2>See where you stand</h2>
				<p class="section-sub">Tell me about your brand and I'll show you where you're showing up, and where you're missing out, across ChatGPT, Google AI Overviews, Gemini, Perplexity and Claude, and who's being recommended instead.</p>
			</div>
			<form class="form reveal" id="contact-form">
				<div class="form-row">
					<input type="text" name="name" placeholder="Your name" required />
					<input type="email" name="email" placeholder="Your email" required />
				</div>
				<input type="text" name="website" placeholder="Your website URL (e.g. www.example.com)" required />
				<textarea name="message" placeholder="Tell me about your brand, your categories and your main competitors" rows="4"></textarea>
				<button type="submit" class="btn btn-full" id="contact-submit">See where I stand</button>
				<p id="contact-status" style="display:none;margin-top:1rem;text-align:center;font-size:0.9rem;"></p>
			</form>

			<script>
				const form = document.getElementById('contact-form') as HTMLFormElement;
				const btn = document.getElementById('contact-submit') as HTMLButtonElement;
				const status = document.getElementById('contact-status') as HTMLParagraphElement;

				form.addEventListener('submit', async (e) => {
					e.preventDefault();
					btn.disabled = true;
					btn.textContent = 'Sending…';
					status.style.display = 'none';

					let website = (form.elements.namedItem('website') as HTMLInputElement).value.trim();
					if (website && !/^https?:\/\//i.test(website)) {
						website = 'https://' + website;
					}

					const data = {
						name: (form.elements.namedItem('name') as HTMLInputElement).value,
						email: (form.elements.namedItem('email') as HTMLInputElement).value,
						website,
						message: (form.elements.namedItem('message') as HTMLTextAreaElement).value,
					};

					try {
						const res = await fetch('/api/contact', {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify(data),
						});

						if (res.ok) {
							form.reset();
